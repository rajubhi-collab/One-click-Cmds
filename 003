#!/bin/bash

# --- COLORS ---
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[1;90m'
GREEN='\033[1;32m'
PURPLE='\033[1;35m'
RED='\033[1;31m'
NC='\033[0m'

# --- HELPER FUNCTIONS ---
print_status() {
    local type=$1
    local msg=$2
    case $type in
        "INFO") echo -e "${CYAN}[INFO]${NC} $msg" ;;
        "SUCCESS") echo -e "${GREEN}[SUCCESS]${NC} $msg" ;;
        "WARN") echo -e "${PURPLE}[WARN]${NC} $msg" ;;
        "ERROR") echo -e "${RED}[ERROR]${NC} $msg" ;;
        "INPUT") echo -ne "${WHITE}[INPUT]${NC} $msg" ;;
    esac
}

check_dependencies() {
    local deps=("qemu-system-x86_64" "wget" "qemu-img" "cloud-localds" "openssl")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            print_status "WARN" "Dependency '$dep' missing. Please install it."
        fi
    done
}

get_vm_list() {
    if [ -d "$VM_DIR" ]; then
        ls "$VM_DIR" 2>/dev/null | grep ".conf" | sed 's/.conf//'
    fi
}

cleanup() {
    rm -f user-data meta-data 2>/dev/null
}

display_header() {
    clear
    echo -e "${CYAN}"
    cat << "EOF"
 ██████╗  █████╗      ██╗██████╗ ██╗  ██╗  █████╗ ██╗
 ██╔══██╗██╔══██╗     ██║██╔══██╗██║  ██║ ██╔══██╗██║
 ██████╔╝███████║     ██║██████╔╝███████║ ███████║██║
 ██╔══██╗██╔══██║██   ██║██╔══██╗██╔══██║ ██╔══██║██║
 ██║  ██║██║  ██║╚██████╔╝██████╔╝██║  ██║ ██║  ██║██║
 ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝ ╚═╝  ╚═╝╚═╝
EOF
    echo -e "          ${WHITE}Made With ❤️ By RAJBHAI${NC}"
    echo ""
}

# --- SYSTEM STATS ---
get_stats() {
    CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}' | cut -d. -f1)
    MEM_USAGE=$(free | grep Mem | awk '{print $3/$2 * 100.0}' | cut -d. -f1)
    echo -e "${WHITE}CPU: ${CYAN}${CPU_USAGE:-0}% ${PURPLE}RAM: ${MEM_USAGE:-0}%${NC}"
}

# --- VM MANAGEMENT ---
create_new_vm() {
    display_header
    print_status "INFO" "🆕 Creating a new Virtual Machine"
    
    # OS Selection
    local os_keys=($(printf '%s\n' "${!OS_OPTIONS[@]}" | sort))
    for i in "${!os_keys[@]}"; do
        echo "  $((i+1))) ${os_keys[$i]}"
    done
    
    read -p "$(print_status "INPUT" "Select OS (1-${#os_keys[@]}): ")" os_choice
    local selected_key="${os_keys[$((os_choice-1))]}"
    
    IFS='|' read -r OS_TYPE CODENAME IMG_URL DEFAULT_HOSTNAME DEFAULT_USER DEFAULT_PASS <<< "${OS_OPTIONS[$selected_key]}"

    read -p "$(print_status "INPUT" "Enter VM Name (default: $DEFAULT_HOSTNAME): ")" VM_NAME
    VM_NAME="${VM_NAME:-$DEFAULT_HOSTNAME}"
    
    IMG_FILE="$VM_DIR/$VM_NAME.qcow2"
    SEED_FILE="$VM_DIR/$VM_NAME-seed.iso"

    if [ ! -f "$IMG_FILE" ]; then
        print_status "INFO" "Downloading $selected_key image..."
        wget -q --show-progress "$IMG_URL" -O "$IMG_FILE"
    fi

    # Cloud-init setup
    cat > user-data <<EOF
#cloud-config
hostname: $VM_NAME
ssh_pwauth: true
users:
  - name: $DEFAULT_USER
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    password: $(openssl passwd -6 "$DEFAULT_PASS")
EOF
    cloud-localds "$SEED_FILE" user-data
    
    # Save config
    cat > "$VM_DIR/$VM_NAME.conf" <<EOF
VM_NAME="$VM_NAME"
IMG_FILE="$IMG_FILE"
SEED_FILE="$SEED_FILE"
SSH_PORT="2222"
MEMORY="2048"
CPUS="2"
EOF
    print_status "SUCCESS" "VM '$VM_NAME' is ready! User: $DEFAULT_USER | Pass: $DEFAULT_PASS"
}

start_vm() {
    local vms=($(get_vm_list))
    if [ ${#vms[@]} -eq 0 ]; then
        print_status "ERROR" "No VMs found."
        return
    fi

    for i in "${!vms[@]}"; do echo "  $((i+1))) ${vms[$i]}"; done
    read -p "Select VM number: " n
    local vm_name="${vms[$((n-1))]}"
    
    source "$VM_DIR/$vm_name.conf"
    
    print_status "INFO" "Starting $vm_name on port $SSH_PORT..."
    qemu-system-x86_64 \
        -m "$MEMORY" \
        -smp "$CPUS" \
        -drive "file=$IMG_FILE,format=qcow2" \
        -drive "file=$SEED_FILE,format=raw" \
        -netdev "user,id=n1,hostfwd=tcp::$SSH_PORT-:22" \
        -device virtio-net-pci,netdev=n1 \
        -nographic
}

# --- MAIN MENU ---
main_menu() {
    while true; do
        display_header
        get_stats
        echo -e "\n1) 🆕 Create VM\n2) 🚀 Start VM\n3) 🗑️  Delete VM\n0) 👋 Exit"
        read -p "Selection: " choice
        case $choice in
            1) create_new_vm ;;
            2) start_vm ;;
            3) 
                read -p "VM Name to delete: " dname
                rm -f "$VM_DIR/$dname.conf" "$VM_DIR/$dname.qcow2" "$VM_DIR/$dname-seed.iso"
                print_status "SUCCESS" "Deleted $dname"
                ;;
            0) exit 0 ;;
        esac
        read -p "Press Enter..."
    done
}

# --- CONFIG & OS LIST ---
VM_DIR="$HOME/vms"
mkdir -p "$VM_DIR"
check_dependencies
trap cleanup EXIT

declare -A OS_OPTIONS=(
    ["Ubuntu 22.04 (Jammy)"]="ubuntu|jammy|https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img|ubuntu22|ubuntu|ubuntu"
    ["Ubuntu 24.04 (Noble)"]="ubuntu|noble|https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img|ubuntu24|ubuntu|ubuntu"
    ["Debian 11 (Bullseye)"]="debian|bullseye|https://cloud.debian.org/images/cloud/bullseye/latest/debian-11-generic-amd64.qcow2|debian11|debian|debian"
    ["Debian 12 (Bookworm)"]="debian|bookworm|https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-generic-amd64.qcow2|debian12|debian|debian"
    ["Debian 13 (Trixie)"]="debian|trixie|https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-generic-amd64-daily.qcow2|debian13|debian|debian"
)

main_menu
