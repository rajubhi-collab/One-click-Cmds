#!/bin/bash

# --- COLORS ---
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[1;90m'
GREEN='\033[1;32m'
PURPLE='\033[1;35m'
RED='\033[1;31m'
NC='\033[0m'

# --- FUNCTION: HEADER ---
display_header() {
    clear
    echo -e "${CYAN}"
    cat << "EOF"
 ██████╗  █████╗      ██╗██████╗ ██╗  ██╗  █████╗ ██╗
 ██╔══██╗██╔══██╗     ██║██╔══██╗██║  ██║ ██╔══██╗██║
 ██████╔╝███████║     ██║██████╔╝███████║ ███████║██║
 ██╔══██╗██╔══██║██   ██║██╔══██╗██╔══██║ ██╔══██║██║
 ██║  ██║██║  ██║╚██████╔╝██████╔╝██║  ██║ ██║  ██║██║
 ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝ ╚═╝  ╚═╝╚═╝
EOF
    echo -e "          ${WHITE}Made With ❤️ By RAJBHAI${NC}"
    echo ""
}

# --- HELPER FUNCTIONS ---
print_status() {
    local type=$1
    local message=$2
    case $type in
        "INFO") echo -e "\033[1;34m📋 [INFO]\033[0m $message" ;;
        "WARN") echo -e "\033[1;33m⚠️  [WARN]\033[0m $message" ;;
        "ERROR") echo -e "\033[1;31m❌ [ERROR]\033[0m $message" ;;
        "SUCCESS") echo -e "\033[1;32m✅ [SUCCESS]\033[0m $message" ;;
        "INPUT") echo -e "\033[1;36m🎯 [INPUT]\033[0m $message" ;;
        *) echo "[$type] $message" ;;
    esac
}

# --- VIRTUALIZATION MENU ---
virt_menu() {
    while true; do
        display_header
        CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}' | awk -F. '{print $1}')
        MEM_USAGE=$(free | grep Mem | awk '{print $3/$2 * 100.0}' | awk -F. '{print $1}')
        DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}' | sed 's/%//')

        echo -e "${WHITE}System Vitality: ${GRAY}CPU: ${CYAN}${CPU_USAGE:-0}% ${GRAY}RAM: ${PURPLE}${MEM_USAGE:-0}% ${GRAY}Disk: ${GREEN}${DISK_USAGE:-0}%${NC}"
        echo ""
        echo -e "${CYAN}  VIRTUALIZATION & NODES${NC}"
        echo -e "${GRAY}  ├── [1] RDX/IDX              [4] Proxmox (Node-1)${NC}"
        echo -e "${GRAY}  ├── [2] VM-1 (KVM Mode)      [5] LXC/LXD Deploy${NC}"
        echo -e "${GRAY}  ├── [3] VM-2 (No-KVM)        [6] Docker Deploy${NC}"
        echo -e "${GRAY}  ├── [7] AMD (EPYC-KVM)${NC}"
        echo -e "${GRAY}  │${NC}"
        echo -e "${GRAY}  └── [0] Back / Exit${NC}"
        echo ""

        read -p "Select Option → " opt
        case $opt in
            1) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/vps.sh) ;;
            2) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/vm.sh) ;;
            3) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/vm2.sh) ;;
            4) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/proxmox.sh) ;;
            5) echo -e "${PURPLE}Coming Soon...${NC}" ; sleep 2 ;;
            6) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/dd.sh) ;;
            7) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/amd.txt) ;;
            0) break ;;
            *) echo -e "${RED}Invalid!${NC}" ; sleep 1 ;;
        esac
    done
}

# --- MAIN EXECUTION ---
VM_DIR="${VM_DIR:-$HOME/vms}"
mkdir -p "$VM_DIR"

# Start the menu
virt_menu
