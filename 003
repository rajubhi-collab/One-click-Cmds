#!/bin/bash

# --- COLORS ---
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[1;90m'
GREEN='\033[1;32m'
PURPLE='\033[1;35m'
NC='\033[0m'

display_header() {
    clear
    echo -e "${CYAN}"
    cat << "EOF"
 ██████╗  █████╗      ██╗██████╗ ██╗  ██╗  █████╗ ██╗
 ██╔══██╗██╔══██╗     ██║██╔══██╗██║  ██║ ██╔══██╗██║
 ██████╔╝███████║     ██║██████╔╝███████║ ███████║██║
 ██╔══██╗██╔══██║██   ██║██╔══██╗██╔══██║ ██╔══██║██║
 ██║  ██║██║  ██║╚██████╔╝██████╔╝██║  ██║ ██║  ██║██║
 ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝ ╚═╝  ╚═╝╚═╝
EOF
    echo -e "          ${WHITE}Made With ❤️ By RAJBHAI${NC}"
    echo ""
}

# --- Accurate Stats ---
CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}' | cut -d. -f1)
[ -z "$CPU_USAGE" ] && CPU_USAGE=0
MEM_USAGE=$(free | grep Mem | awk '{print $3/$2 * 100.0}' | cut -d. -f1)
DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}' | sed 's/%//')

# --- MAIN MENU FUNCTION ---
# Humne check_dependencies ko yahan se hata diya hai taaki menu hamesha dikhe
main_menu() {
    display_header
    echo -e "${WHITE}System Vitality: ${GRAY}CPU: ${CYAN}${CPU_USAGE}% ${GRAY}RAM: ${PURPLE}${MEM_USAGE}% ${GRAY}Disk: ${GREEN}${DISK_USAGE}%${NC}"
    echo ""

    echo -e "${CYAN}  VIRTUALIZATION & NODES${NC}"
    echo -e "${GRAY}  ├── [1] RDX/IDX              [4] Proxmox (Node-1)${NC}"
    echo -e "${GRAY}  ├── [2] VM-1 (KVM Mode)      [5] LXC/LXD Deploy${NC}"
    echo -e "${GRAY}  ├── [3] VM-2 (No-KVM)        [6] Docker Deploy${NC}"
    echo -e "${GRAY}  ├── [7] AMD EPYC             [0] Back/Exit${NC}"
    echo ""

    read -p "Select Option → " opt

    case $opt in
        1) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/vps.sh) ;;
        2) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/Hub-of-raj/refs/heads/main/srv/vm/vm.sh) ;;
        3) bash <(curl -s https://raw.githubusercontent.com/nobita329/The-Coding-Hub/refs/heads/main/srv/vm/vm2.sh) ;;
        4) bash <(curl -s https://raw.githubusercontent.com/nobita329/The-Coding-Hub/refs/heads/main/srv/vm/proxmox.sh) ;;
        5) echo -e "${PURPLE}Coming Soon...${NC}" ; sleep 2 ; main_menu ;;
        6) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/srv/vm/dd.sh) ;;
        7) bash <(curl -s https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/amd) ;;
        0) exit 0 ;;
        *) echo -e "${RED}Invalid!${NC}" ; sleep 1 ; main_menu ;;
    esac
}

# Start the script
main_menu
