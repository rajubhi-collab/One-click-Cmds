# ---- PTERODACTYL MENU ----
ptero_menu() {
    while true; do banner
        echo -e "${CYAN}────────────── PTERODACTYL MENU ──────────────${NC}"
        echo -e "${YELLOW} 1)${WHITE} Install Panel"
        echo -e "${YELLOW} 2)${WHITE} Install Wings"
        echo -e "${YELLOW} 3)${WHITE} Create User"
        echo -e "${YELLOW} 4)${WHITE} Update Panel"
        echo -e "${YELLOW} 5)${WHITE} Install SSL"
        echo -e "${YELLOW} 6)${WHITE} Uninstall Panel"
        echo -e "${YELLOW} 7)${WHITE} Back"
        echo -e "${CYAN}──────────────────────────────────────────────${NC}"
        read -p "Select option: " opt

        case $opt in
            1) bash <(curl -fsSL https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/install.sh) ;;
            2) bash <(curl -fsSL https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/wings) ;;
            3) cd /var/www/pterodactyl 2>/dev/null && php artisan p:user:make ;;
            4) cd /var/www/pterodactyl || { echo "Panel not installed!"; sleep 2; continue; }
               php artisan down
               curl -Lo panel.tar.gz https://github.com/pterodactyl/panel/releases/latest/download/panel.tar.gz
               tar -xzvf panel.tar.gz
               COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --optimize-autoloader
               php artisan migrate --seed --force
               php artisan up ;;
            5) bash <(curl -fsSL https://raw.githubusercontent.com/rajubhi-collab/One-click-Cmds/refs/heads/main/ssh.sh) ;;
            6) rm -rf /var/www/pterodactyl && echo "Panel Removed." ;;
            7) break ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

