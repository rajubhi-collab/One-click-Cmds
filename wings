#!/bin/bash

# ==========================================
#  RAJBHAI PTERODACTYL WINGS INSTALLER
#  Latest Version | Auto Arch Detection
# ==========================================

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
GRAY='\033[1;90m'
NC='\033[0m'

CHECKMARK="✔"
CROSSMARK="✘"
ARROW="➤"

# --- UI Helpers ---
print_header() {
    echo -e "\n${MAGENTA}╔══════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║${NC}  ${CYAN}$1${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════╝${NC}"
}

print_status() { echo -e "  ${YELLOW}${ARROW} $1...${NC}"; }
print_success() { echo -e "  ${GREEN}${CHECKMARK} $1${NC}"; }
print_error()   { echo -e "  ${RED}${CROSSMARK} $1${NC}"; }
print_info()    { echo -e "  ${CYAN}➜ $1${NC}"; }

spinner() {
    local pid=$1 msg=$2
    local spinstr='⣾⣽⣻⢿⡿⣟⣯⣷'
    echo -ne "  ${CYAN}⏳ ${msg}${NC} "
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf "[%c] " "$spinstr"
        spinstr=$temp${spinstr%"$temp"}
        sleep 0.1
        printf "\b\b\b\b"
    done
    printf "    \b\b\b\b"
    echo -e "${GREEN}✔ done${NC}"
}

# --- Header ---
clear
echo -e "${BLUE}"
echo "╔══════════════════════════════════════════════╗"
echo "║     🐦 PTERODACTYL WINGS INSTALLER          ║"
echo "║          Made By - RAJBHAI                  ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

# --- Root Check ---
if [[ $EUID -ne 0 ]]; then
    print_error "Please run as root!"
    exit 1
fi

# --- Check if Wings is already installed ---
if [ -f /usr/local/bin/wings ]; then
    EXISTING_VER=$(/usr/local/bin/wings --version 2>/dev/null | head -1 || echo "unknown")
    echo -e "${YELLOW}  ⚠  Wings already installed: ${EXISTING_VER}${NC}"
    read -p "  Re-install / upgrade? (y/n): " REINSTALL
    [[ "$REINSTALL" != "y" && "$REINSTALL" != "Y" ]] && echo -e "${GREEN}  Exiting.${NC}" && exit 0
fi

# --- Detect Architecture ---
print_header "SYSTEM CHECK"
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)  ARCH_LABEL="amd64" ;;
    aarch64) ARCH_LABEL="arm64" ;;
    armv7l)  ARCH_LABEL="arm"   ;;
    *)
        print_error "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac
print_success "Architecture: ${ARCH} → ${ARCH_LABEL}"

OS=$(lsb_release -is 2>/dev/null | tr '[:upper:]' '[:lower:]' || echo "unknown")
CODENAME=$(lsb_release -cs 2>/dev/null || echo "unknown")
print_success "OS: ${OS} ${CODENAME}"

# --- Install Docker ---
print_header "INSTALLING DOCKER"
print_status "Downloading and installing Docker"
(curl -sSL https://get.docker.com/ | CHANNEL=stable bash) &>/dev/null &
spinner $! "Installing Docker"

print_status "Enabling Docker service"
systemctl enable --now docker &>/dev/null
print_success "Docker installed and running"

# --- Update GRUB for swap accounting ---
print_header "SYSTEM CONFIGURATION"
GRUB_FILE="/etc/default/grub"
if [ -f "$GRUB_FILE" ]; then
    print_status "Enabling swap accounting in GRUB"
    current=$(grep "^GRUB_CMDLINE_LINUX_DEFAULT=" "$GRUB_FILE" | sed 's/GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/\1/')
    if echo "$current" | grep -q "swapaccount"; then
        print_info "Swap accounting already set"
    else
        sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT=\"${current} swapaccount=1\"/" "$GRUB_FILE"
        update-grub &>/dev/null
        print_success "GRUB updated (swap accounting enabled)"
    fi
else
    print_info "GRUB config not found, skipping"
fi

# --- Get Latest Wings Version ---
print_header "INSTALLING WINGS"
WINGS_VERSION=$(curl -s https://api.github.com/repos/pterodactyl/wings/releases/latest | grep '"tag_name"' | sed -E 's/.*"([^"]+)".*/\1/')
[[ -z "$WINGS_VERSION" ]] && WINGS_VERSION="latest"
WINGS_URL="https://github.com/pterodactyl/wings/releases/download/${WINGS_VERSION}/wings_linux_${ARCH_LABEL}"
[[ "$WINGS_VERSION" == "latest" ]] && WINGS_URL="https://github.com/pterodactyl/wings/releases/latest/download/wings_linux_${ARCH_LABEL}"
print_info "Wings version: ${WINGS_VERSION}"

print_status "Creating Wings directory"
mkdir -p /etc/pterodactyl
print_success "Directory /etc/pterodactyl ready"

print_status "Downloading Wings binary"
(curl -L -o /usr/local/bin/wings "${WINGS_URL}") &>/dev/null &
spinner $! "Downloading wings_linux_${ARCH_LABEL}"

chmod +x /usr/local/bin/wings
print_success "Wings binary installed at /usr/local/bin/wings"

# --- Wings systemd Service ---
print_header "CONFIGURING WINGS SERVICE"
print_status "Creating systemd service"
tee /etc/systemd/system/wings.service > /dev/null << 'EOF'
[Unit]
Description=Pterodactyl Wings Daemon
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
User=root
WorkingDirectory=/etc/pterodactyl
LimitNOFILE=4096
PIDFile=/var/run/wings/daemon.pid
ExecStart=/usr/local/bin/wings
Restart=on-failure
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable wings
print_success "Wings service enabled (not started — needs config first)"

# --- Self-Signed SSL for Wings ---
print_header "GENERATING WINGS SSL"
print_status "Creating SSL certificate"
mkdir -p /etc/certs/wing
(openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509 \
    -subj "/C=NA/ST=NA/L=NA/O=Pterodactyl Wings/CN=wings" \
    -keyout /etc/certs/wing/privkey.pem \
    -out /etc/certs/wing/fullchain.pem) &>/dev/null &
spinner $! "Generating RSA 4096 certificate"
print_success "SSL certificate at /etc/certs/wing/"

# --- Helper Command ---
print_header "WINGS HELPER COMMAND"
tee /usr/local/bin/wing > /dev/null << 'EOF'
#!/bin/bash
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
echo ""
echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
echo -e "${CYAN}║     Wings Helper Commands          ║${NC}"
echo -e "${CYAN}╠════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${GREEN}start${NC}   → systemctl start wings"
echo -e "${CYAN}║${NC}  ${GREEN}stop${NC}    → systemctl stop wings"
echo -e "${CYAN}║${NC}  ${YELLOW}restart${NC} → systemctl restart wings"
echo -e "${CYAN}║${NC}  ${GREEN}status${NC}  → systemctl status wings"
echo -e "${CYAN}║${NC}  ${GREEN}logs${NC}    → journalctl -u wings -f"
echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
echo ""
case "$1" in
    start)   systemctl start wings ;;
    stop)    systemctl stop wings ;;
    restart) systemctl restart wings ;;
    status)  systemctl status wings ;;
    logs)    journalctl -u wings -f ;;
    *) echo "Usage: wing [start|stop|restart|status|logs]" ;;
esac
EOF
chmod +x /usr/local/bin/wing
print_success "Helper installed — run 'wing' anytime"

# --- Done ---
print_header "INSTALLATION COMPLETE"
echo ""
echo -e "${GREEN}  ${CHECKMARK} Docker installed and running${NC}"
echo -e "${GREEN}  ${CHECKMARK} Wings ${WINGS_VERSION} installed (${ARCH_LABEL})${NC}"
echo -e "${GREEN}  ${CHECKMARK} systemd service configured${NC}"
echo -e "${GREEN}  ${CHECKMARK} SSL certificate generated${NC}"
echo -e "${GREEN}  ${CHECKMARK} 'wing' helper command ready${NC}"
echo ""
echo -e "${CYAN}  ┌─── Next Steps ────────────────────────────────────┐${NC}"
echo -e "${CYAN}  │${NC}  1. Go to your Panel → Nodes → Create Node"
echo -e "${CYAN}  │${NC}  2. Copy the config token from the node page"
echo -e "${CYAN}  │${NC}  3. Paste it into: /etc/pterodactyl/config.yml"
echo -e "${CYAN}  │${NC}  4. Start Wings:  ${GREEN}systemctl start wings${NC}"
echo -e "${CYAN}  │${NC}  5. Check status: ${GREEN}wing status${NC}"
echo -e "${CYAN}  └───────────────────────────────────────────────────┘${NC}"
echo ""
